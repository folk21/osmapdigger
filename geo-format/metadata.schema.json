{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "formatVersion",
    "datasetId",
    "displayName",
    "generatedAt",
    "source",
    "artifacts",
    "bounds",
    "center",
    "statistics"
  ],
  "properties": {
    "formatVersion": {
      "type": "integer",
      "minimum": 1
    },
    "datasetId": {
      "type": "string",
      "minLength": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "countryCode": {
      "type": [
        "string",
        "null"
      ]
    },
    "generatedAt": {
      "type": "string"
    },
    "source": {
      "type": "object"
    },
    "artifacts": {
      "type": "object"
    },
    "bounds": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "number"
      }
    },
    "center": {
      "type": "object",
      "required": [
        "latitude",
        "longitude",
        "zoom"
      ]
    },
    "statistics": {
      "type": "object"
    },
    "propertySearch": {
      "type": "object",
      "required": [
        "site",
        "terms"
      ],
      "properties": {
        "site": {
          "type": [
            "string",
            "null"
          ]
        },
        "terms": {
          "type": "string"
        }
      }
    },
    "interpretation": {
      "description": "Optional deterministic interpretation catalog. Absent or null means unavailable; present v1 objects have explicit bounded sections.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/interpretationCatalog"
        }
      ]
    }
  },
  "$defs": {
    "interpretationCatalog": {
      "type": "object",
      "required": [
        "version",
        "dimensions",
        "goalProfiles",
        "insightRules"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "dimensions": {
          "type": "array",
          "minItems": 0,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/interpretationDimension"
          }
        },
        "goalProfiles": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/interpretationGoalProfile"
          }
        },
        "insightRules": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/interpretationInsightRule"
          }
        }
      }
    },
    "interpretationLabels": {
      "type": "object",
      "required": [
        "en",
        "ru"
      ],
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        },
        "ru": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "\\S"
        }
      }
    },
    "interpretationDimension": {
      "type": "object",
      "required": [
        "id",
        "labels",
        "sortOrder",
        "metricIds",
        "minimumCoverage",
        "minimumKnownMetrics"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "labels": {
          "$ref": "#/$defs/interpretationLabels"
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "metricIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)+$"
          },
          "uniqueItems": true
        },
        "minimumCoverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "minimumKnownMetrics": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "interpretationPreference": {
      "type": "object",
      "required": [
        "metricId",
        "enabled",
        "direction",
        "target",
        "limit",
        "weight"
      ],
      "additionalProperties": false,
      "properties": {
        "metricId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z0-9_]+)+$"
        },
        "enabled": {
          "type": "boolean"
        },
        "direction": {
          "enum": [
            "lower",
            "higher"
          ]
        },
        "target": {
          "type": "number",
          "minimum": -1000000000000,
          "maximum": 1000000000000
        },
        "limit": {
          "type": "number",
          "minimum": -1000000000000,
          "maximum": 1000000000000
        },
        "weight": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "interpretationGoalProfile": {
      "type": "object",
      "required": [
        "id",
        "labels",
        "sortOrder",
        "preferences"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "labels": {
          "$ref": "#/$defs/interpretationLabels"
        },
        "sortOrder": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "preferences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/interpretationPreference"
          }
        }
      }
    },
    "interpretationInsightRule": {
      "type": "object",
      "required": [
        "id",
        "type",
        "dimensionIds",
        "templateKey",
        "minimumCoverage",
        "minimumKnownMetrics"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
        },
        "type": {
          "enum": [
            "dimension-strength",
            "dimension-tradeoff",
            "dimension-contrast"
          ]
        },
        "dimensionIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
          },
          "uniqueItems": true
        },
        "templateKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^interpretation\\.[a-z0-9_-]+(?:\\.[a-z0-9_-]+)*$"
        },
        "minimumCoverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "minimumKnownMetrics": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "minimumScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "maximumScore": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "dimension-strength"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "minimumScore"
            ],
            "properties": {
              "dimensionIds": {
                "minItems": 1,
                "maxItems": 1
              }
            },
            "not": {
              "required": [
                "maximumScore"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "dimension-tradeoff"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "maximumScore"
            ],
            "properties": {
              "dimensionIds": {
                "minItems": 1,
                "maxItems": 1
              }
            },
            "not": {
              "required": [
                "minimumScore"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "dimension-contrast"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "minimumScore",
              "maximumScore"
            ],
            "properties": {
              "dimensionIds": {
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        }
      ]
    }
  }
}
